{
  "name": "privatraum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "codex:probe": "tsx scripts/probe.ts",
    "codex:login": "tsx scripts/login.ts",
    "test:live": "tsx scripts/live.ts",
    "test:web-search": "tsx scripts/web-search-live.ts",
    "setup": "tsx scripts/setup.ts",
    "setup:wsl": "node scripts/wsl-setup.mjs",
    "wsl:probe": "node scripts/wsl.mjs probe",
    "wsl:login": "node scripts/wsl.mjs login",
    "wsl:live": "node scripts/wsl.mjs live",
    "wsl:web-search": "node scripts/wsl.mjs web-search",
    "wsl:key": "node scripts/wsl.mjs setup-key",
    "wsl:build": "node scripts/wsl.mjs build",
    "wsl:test": "node scripts/wsl.mjs test",
    "format": "prettier --write src server scripts tests"
  },
  "dependencies": {
    "@openai/codex": "0.153.4",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "heic2any": "^0.0.4",
    "helmet": "^8.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.20.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.9.6",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^4.1.11"
  }
}
