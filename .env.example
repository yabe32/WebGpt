HOST=127.0.0.1
PORT=3001
FRONTEND_PORT=5173
BASE_URL=http://localhost:5173
DATA_DIR=.data
NODE_ENV=development
# MODEL bleibt leer: Codex-Katalogstandard mit Bildeingabe.
MODEL=
WEB_SEARCH=live
MAX_UPLOAD_MB=15
# Antwort nach drei Minuten ohne Textdelta oder Bild sicher beenden.
TURN_IDLE_TIMEOUT_SECONDS=180
# Nur Produktion hinter Caddy:
TRUST_PROXY=false
# Ubuntu Compose (lokal nicht benötigt):
DOMAIN=
ACME_EMAIL=
